{
  "name": "psychedelic-puppet-show",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "wrangler": "4.152.0",
    "@cloudflare/workers-types": "5.20261022.1"
  },
  "type": "module",
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    },
    "fast-uri@^3.0.0": "3.1.8"
  }
}
